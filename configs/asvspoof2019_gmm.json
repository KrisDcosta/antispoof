{
  "data": "data/LA",
  "output": "results/baseline",
  "cache_dir": "results/feature_cache",
  "features": ["lfcc", "mfcc", "cqcc"],
  "splits": ["dev", "eval"],
  "gmm_components": 64,
  "covariance_type": "diag",
